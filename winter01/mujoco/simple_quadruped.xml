<mujoco model="simple_quadruped">
  <compiler angle="radian" coordinate="local" meshdir=""/>

  <option timestep="0.002" iterations="50" solver="Newton"/>

  <default>
    <joint type="hinge" damping="0.5" armature="0.01" limited="true"/>
    <geom type="capsule" size="0.02" rgba="0.5 0.5 0.5 1"/>
    <motor ctrlrange="-10 10" gear="50"/>
  </default>

  <worldbody>
    <!-- 地面和灯光 -->
    <light name="light0" pos="0 0 3" dir="0 0 -1"/>
    <geom name="floor" type="plane" size="2 2 0.1" rgba="0.8 0.9 0.8 1"/>

    <!-- 躯干（身体） -->
    <body name="torso" pos="0 0 0.2">
      <inertial pos="0 0 0" mass="5" diaginertia="0.1 0.1 0.1"/>
      <geom name="torso_geom" type="box" size="0.2 0.1 0.05" rgba="0.2 0.3 0.8 1"/>

      <!-- 左前腿 (LF) -->
      <body name="lf_hip" pos="0.15 0.1 0">
        <inertial pos="0 0 -0.05" mass="0.5" diaginertia="0.01 0.01 0.001"/>
        <geom name="lf_hip_geom" fromto="0 0 0 0 0 -0.1" size="0.025" rgba="0.8 0.2 0.2 1"/>
        <joint name="lf_hip_joint" axis="1 0 0" range="-0.5 0.5"/>
        <body name="lf_knee" pos="0 0 -0.1">
          <inertial pos="0 0 -0.1" mass="0.3" diaginertia="0.005 0.005 0.001"/>
          <geom name="lf_knee_geom" fromto="0 0 0 0 0 -0.2" size="0.02" rgba="0.2 0.8 0.2 1"/>
          <joint name="lf_knee_joint" axis="1 0 0" range="-1.5 0"/>
          <!-- 足端 -->
          <geom name="lf_foot" type="sphere" size="0.03" pos="0 0 -0.2" rgba="0.1 0.1 0.1 1"/>
        </body>
      </body>

      <!-- 右前腿 (RF) -->
      <body name="rf_hip" pos="0.15 -0.1 0">
        <inertial pos="0 0 -0.05" mass="0.5" diaginertia="0.01 0.01 0.001"/>
        <geom name="rf_hip_geom" fromto="0 0 0 0 0 -0.1" size="0.025" rgba="0.8 0.2 0.2 1"/>
        <joint name="rf_hip_joint" axis="1 0 0" range="-0.5 0.5"/>
        <body name="rf_knee" pos="0 0 -0.1">
          <inertial pos="0 0 -0.1" mass="0.3" diaginertia="0.005 0.005 0.001"/>
          <geom name="rf_knee_geom" fromto="0 0 0 0 0 -0.2" size="0.02" rgba="0.2 0.8 0.2 1"/>
          <joint name="rf_knee_joint" axis="1 0 0" range="-1.5 0"/>
          <geom name="rf_foot" type="sphere" size="0.03" pos="0 0 -0.2" rgba="0.1 0.1 0.1 1"/>
        </body>
      </body>

      <!-- 左后腿 (LH) -->
      <body name="lh_hip" pos="-0.15 0.1 0">
        <inertial pos="0 0 -0.05" mass="0.5" diaginertia="0.01 0.01 0.001"/>
        <geom name="lh_hip_geom" fromto="0 0 0 0 0 -0.1" size="0.025" rgba="0.8 0.2 0.2 1"/>
        <joint name="lh_hip_joint" axis="1 0 0" range="-0.5 0.5"/>
        <body name="lh_knee" pos="0 0 -0.1">
          <inertial pos="0 0 -0.1" mass="0.3" diaginertia="0.005 0.005 0.001"/>
          <geom name="lh_knee_geom" fromto="0 0 0 0 0 -0.2" size="0.02" rgba="0.2 0.8 0.2 1"/>
          <joint name="lh_knee_joint" axis="1 0 0" range="-1.5 0"/>
          <geom name="lh_foot" type="sphere" size="0.03" pos="0 0 -0.2" rgba="0.1 0.1 0.1 1"/>
        </body>
      </body>

      <!-- 右后腿 (RH) -->
      <body name="rh_hip" pos="-0.15 -0.1 0">
        <inertial pos="0 0 -0.05" mass="0.5" diaginertia="0.01 0.01 0.001"/>
        <geom name="rh_hip_geom" fromto="0 0 0 0 0 -0.1" size="0.025" rgba="0.8 0.2 0.2 1"/>
        <joint name="rh_hip_joint" axis="1 0 0" range="-0.5 0.5"/>
        <body name="rh_knee" pos="0 0 -0.1">
          <inertial pos="0 0 -0.1" mass="0.3" diaginertia="0.005 0.005 0.001"/>
          <geom name="rh_knee_geom" fromto="0 0 0 0 0 -0.2" size="0.02" rgba="0.2 0.8 0.2 1"/>
          <joint name="rh_knee_joint" axis="1 0 0" range="-1.5 0"/>
          <geom name="rh_foot" type="sphere" size="0.03" pos="0 0 -0.2" rgba="0.1 0.1 0.1 1"/>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <!-- 髋关节执行器 -->
    <motor name="lf_hip_motor" joint="lf_hip_joint"/>
    <motor name="rf_hip_motor" joint="rf_hip_joint"/>
    <motor name="lh_hip_motor" joint="lh_hip_joint"/>
    <motor name="rh_hip_motor" joint="rh_hip_joint"/>
    <!-- 膝关节执行器 -->
    <motor name="lf_knee_motor" joint="lf_knee_joint"/>
    <motor name="rf_knee_motor" joint="rf_knee_joint"/>
    <motor name="lh_knee_motor" joint="lh_knee_joint"/>
    <motor name="rh_knee_motor" joint="rh_knee_joint"/>
  </actuator>
</mujoco>