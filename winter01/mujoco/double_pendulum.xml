<mujoco model="double_pendulum">
  <compiler angle="radian" coordinate="local"/>

  <worldbody>
    <light name="light0" pos="0 0 3" dir="0 0 -1"/>
    <geom name="floor" type="plane" size="2 2 0.1" rgba="0.8 0.9 0.8 1"/>

    <!-- 基座：直接作为世界中的一个body，没有固定关节 -->
    <body name="base" pos="0 0 1">
      <inertial pos="0 0 0" mass="1.0" diaginertia="0.01 0.01 0.01"/>
      <geom name="base_geom" type="box" size="0.05 0.05 0.05" rgba="0.2 0.3 0.8 1"/>

      <!-- 第一摆杆 -->
      <body name="link1" pos="0 0 0">
        <inertial pos="0 0 -0.25" mass="0.5" diaginertia="0.01 0.01 0.001"/>
        <geom name="link1_geom" type="cylinder" size="0.02 0.25" 
              fromto="0 0 0 0 0 -0.5" rgba="0.8 0.2 0.2 1"/>
        <joint name="joint1" type="hinge" pos="0 0 0" axis="0 1 0" 
               limited="true" range="-2 2" damping="1.0"/>

        <!-- 第二摆杆 -->
        <body name="link2" pos="0 0 -0.5">
          <inertial pos="0 0 -0.25" mass="0.3" diaginertia="0.005 0.005 0.001"/>
          <geom name="link2_geom" type="cylinder" size="0.015 0.25" 
                fromto="0 0 0 0 0 -0.5" rgba="0.2 0.3 0.8 1"/>
          <joint name="joint2" type="hinge" pos="0 0 0" axis="0 1 0" 
                 limited="true" range="-2 2" damping="1.0"/>
        </body>
      </body>
    </body>
  </worldbody>
</mujoco>